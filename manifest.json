{
  "manifest_version": 3,
  "name": "SpoilWipe",
  "version": "1.0",
  "description": "Blocks spoiler videos from websites like TikTok or YouTube.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://www.omdbapi.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtu.be/*"
      ],
      "js": [
        "utils/smartKeywords.js",
        "content/contentScript.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup/fullscreen.css", "popup/light-theme.css", "popup/popup-light-theme.css"],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtu.be/*"
      ]
    }
  ]
}
