{
  "manifest_version": 3,
  "name": "SpoilWipe",
  "version": "1.0",
  "description": "Blocks spoiler videos from websites like TikTok or YouTube.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/contentScript.js"]
    }
  ]
}
